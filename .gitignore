# Python
__pycache__/
*.py[cod]
*.so
.venv/
backend/.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Local configuration and IDE state
.env
.env.*
!.env.example
.vscode/settings.json
.idea/
.DS_Store

# Local mission data (large or subject to source-specific redistribution terms)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated registration products and experiment outputs
outputs/*
!outputs/.gitkeep

# Frontend dependencies and build products
frontend/node_modules/
frontend/dist/

# Logs and local caches
*.log
*.tmp
*.swp
.ipynb_checkpoints/

# Persistent local job state
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Python package build outputs
backend/build/
backend/dist/

# Browser verification outputs (may contain local mission quicklooks)
frontend/playwright-report/
frontend/test-results/

# New API products/uploads may contain restricted mission imagery.
# Existing tracked historical assets still require the release audit.
data/results/*
!data/results/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/sample_pairs/*
!data/sample_pairs/.gitkeep
