{
  "name": "lunarcv-workspace",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "format": "prettier --write src/workspace src/main.jsx src/App.jsx vite.config.js",
    "format:check": "prettier --check src/workspace src/main.jsx src/App.jsx vite.config.js"
  },
  "dependencies": {
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "^8.2.2"
  }
}
